MEDINTELOS_APP_NAME=MedIntelOS
MEDINTELOS_ENVIRONMENT=development
MEDINTELOS_API_KEY=replace-with-a-long-random-secret
MEDINTELOS_FHIR_BASE_URL=http://localhost:8080
MEDINTELOS_REQUIRE_API_KEY=true
MEDINTELOS_MAX_RESOURCE_BYTES=1000000

# FHIR storage backend: "memory" (default, lost on restart) or "postgres"
# (persistent; requires MEDINTELOS_DATABASE_URL and `alembic upgrade head`
# run once beforehand — see docs/DEPLOYMENT.md). The docker-compose.yml
# "db" service and default MEDINTELOS_DATABASE_URL below match each other;
# change both together if you rename the service or database.
MEDINTELOS_FHIR_BACKEND=memory
MEDINTELOS_DATABASE_URL=postgresql://medintelos:replace-with-a-long-random-secret@db:5432/medintelos
MEDINTELOS_DATABASE_POOL_MIN_SIZE=1
MEDINTELOS_DATABASE_POOL_MAX_SIZE=10

# Only used by the docker-compose.yml "db" service itself, not read by the
# app directly — must match the credentials embedded in
# MEDINTELOS_DATABASE_URL above.
POSTGRES_USER=medintelos
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=medintelos

# Durable audit log: "memory" (default) or "postgres" (requires
# MEDINTELOS_DATABASE_URL, same as MEDINTELOS_FHIR_BACKEND above — they can
# be set independently, but most deployments set both together).
MEDINTELOS_AUDIT_BACKEND=memory

# OAuth2/OIDC bearer-token auth, alongside (not instead of) the API key
# above. Disabled by default. All three of ISSUER/AUDIENCE/JWKS_URL are
# required together when enabled — see docs/DEPLOYMENT.md.
MEDINTELOS_OAUTH_ENABLED=false
MEDINTELOS_OAUTH_ISSUER=
MEDINTELOS_OAUTH_AUDIENCE=
MEDINTELOS_OAUTH_JWKS_URL=
MEDINTELOS_OAUTH_JWKS_CACHE_SECONDS=300

# In-memory, per-process rate limiting (token bucket). See docs/DEPLOYMENT.md
# for the multi-instance boundary.
MEDINTELOS_RATE_LIMIT_ENABLED=true
MEDINTELOS_RATE_LIMIT_REQUESTS_PER_MINUTE=120
MEDINTELOS_RATE_LIMIT_BURST=20
